# Copy to backend/.env for local development. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://Ruralpulse:Ruralpulse@localhost:5432/Ruralpulse
# Required in production: at least 32 random characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# AI provider: "anthropic" or "none" (template fallback, no LLM calls).
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# Optional BHASHINI credentials (set both or neither).
BHASHINI_USER_ID=
BHASHINI_API_KEY=
